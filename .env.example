# ===== LLM Providers(至少配置一个即可) =====
OPENAI_API_KEY=***
ANTHROPIC_API_KEY=***
DEEPSEEK_API_KEY=*** 推荐:本项目原生适配(deepseek-v4-flash / deepseek-v4-pro)
DASHSCOPE_API_KEY=*** 通义千问(OpenAI 兼容)
ZHIPU_API_KEY=*** 智谱 GLM(OpenAI 兼容)
MINIMAX_API_KEY=*** MiniMax(OpenAI 兼容)
OPENROUTER_API_KEY=*** OpenRouter 聚合(一个 key 用多种模型)

# ===== 第三方中转 / 代理网关地址(可选) =====
# 设置后所有模型请求走此地址(如 DeepSeek 官方中转、OpenRouter 等)
# LLM_BASE_URL=

# ===== 本地模型(可选,走 OpenAI 兼容) =====
# OLLAMA_BASE_URL=http://localhost:11434/v1
# 使用本地模型时在 config 里把模型名改成你拉取的模型(如 qwen2.5:7b)
